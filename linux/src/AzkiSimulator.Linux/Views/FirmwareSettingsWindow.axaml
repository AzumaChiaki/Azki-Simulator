<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AzkiSimulator.Linux.ViewModels"
        x:Class="AzkiSimulator.Linux.Views.FirmwareSettingsWindow"
        x:DataType="vm:FirmwareSettingsViewModel"
        Title="固件设置"
        Width="680" Height="640"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Margin="24,20">
      <StackPanel Spacing="14">
        <TextBlock Classes="captionSecondary" TextWrapping="Wrap"
                   Text="下次开机时写入固件自己的系统设置数据库（persist.db），并按以下时钟启动；佩戴、心率、步行、电量、充电在“设备数据”中修改。设置按实例的硬件预设生效。" />
        <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left"
                     IsVisible="{Binding !Loaded}" />
        <StackPanel Spacing="12" IsVisible="{Binding Loaded}">
          <TextBlock Classes="sectionHeader" Text="时间" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="开机时间" Width="96" VerticalAlignment="Center" />
            <ComboBox Width="260" SelectedIndex="{Binding ClockModeIndex}">
              <ComboBoxItem>跟随本机时间</ComboBoxItem>
              <ComboBoxItem>自定义时间</ComboBoxItem>
              <ComboBoxItem>保持固件自己的时间</ComboBoxItem>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomClock}">
            <TextBlock Text="设备时间" Width="96" VerticalAlignment="Center" />
            <CalendarDatePicker SelectedDate="{Binding CustomTime}" />
          </StackPanel>
          <TextBlock Classes="captionSecondary" TextWrapping="Wrap" IsVisible="{Binding IsCustomClock}"
                     Text="每次开机都按“现在 + 相同偏移”计算，设备时间随本机一起走。" />
          <TextBlock Classes="sectionHeader" Text="系统" />
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FirmwareChoiceViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Title}" Width="96" VerticalAlignment="Center" />
                  <ComboBox Width="320" ItemsSource="{Binding Labels}" SelectedIndex="{Binding SelectedIndex}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="sectionHeader" Text="全部属性" />
          <TextBox Watermark="筛选属性" Text="{Binding Filter}" Width="280" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FirmwarePropertyRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Key}" FontFamily="Consolas,monospace" FontSize="12" />
                    <TextBlock Classes="captionSecondary" Text="{Binding ObservedText}" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="修改" Command="{Binding EditCommand}" IsVisible="{Binding IsAbsent}" />
                    <TextBlock Text="将恢复默认" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsReset}" />
                    <TextBox Text="{Binding ValueText}" Width="180" IsVisible="{Binding IsOverride}" />
                    <Button Content="撤销" Command="{Binding UndoCommand}" IsVisible="{Binding !IsAbsent}" />
                    <Button Content="恢复默认" Command="{Binding ResetDefaultCommand}" IsVisible="{Binding ShowsResetButton}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewKey}" Watermark="persist.新属性" Width="220" />
            <TextBox Text="{Binding NewValue}" Watermark="值" Width="180" />
            <Button Content="添加" Command="{Binding AddCommand}" />
          </StackPanel>
          <TextBlock Classes="captionSecondary" TextWrapping="Wrap"
                     Text="留空表示保持固件当前值；“恢复默认”会删除该项，让固件使用内置默认值。" />
          <TextBlock Foreground="#C42B1C" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding HasMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding LoadFailed}">
            <TextBlock Classes="captionSecondary" TextWrapping="Wrap"
                       Text="未能读取已保存的设置；可重试，或直接保存以写入新的设置。" />
            <Button Content="重新读取" Command="{Binding RetryCommand}" />
          </StackPanel>
          <TextBlock Classes="captionSecondary" Text="{Binding ObservedAtText}"
                     IsVisible="{Binding ShowsObservedAt}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="24,0,24,20" HorizontalAlignment="Right">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="保存并重新开机" Command="{Binding SaveRestartCommand}"
              IsVisible="{Binding RestartAvailable}" Classes="accent" />
      <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent" />
    </StackPanel>
  </Grid>
</Window>
