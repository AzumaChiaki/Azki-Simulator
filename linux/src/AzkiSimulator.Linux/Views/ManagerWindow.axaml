<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AzkiSimulator.Linux.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:core="using:AzkiSimulator.Linux.Core"
        x:Class="AzkiSimulator.Linux.Views.ManagerWindow"
        x:DataType="vm:ManagerViewModel"
        Title="Azki Simulator — 实例管理"
        Width="1120" Height="760"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="24,20,24,12" Spacing="2">
      <TextBlock Classes="pageHeader" Text="Azki Simulator" />
      <TextBlock Classes="captionSecondary" Text="实例与固件库" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="3*,16,2*" Margin="24,0,24,16">
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="sectionHeader" Text="实例" VerticalAlignment="Center" />
              <Button Content="打开设备" Command="{Binding OpenDeviceCommand}" Classes="accent" />
              <Button Content="重置数据" Command="{Binding ResetInstanceCommand}" />
              <Button Content="删除实例" Command="{Binding DeleteInstanceCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                     MinHeight="180" DoubleTapped="OpenDevice_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:InstanceRecord">
                  <StackPanel Spacing="2" Margin="0,4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="captionSecondary" Text="{Binding Model}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="sectionHeader" Text="主机状态共享" VerticalAlignment="Center" />
              <Button Content="刷新" Command="{Binding RefreshHostStatusCommand}" />
            </StackPanel>
            <TextBlock Classes="captionSecondary" Text="只读展示其他 Azki 宿主在本机共享的状态会话；本应用不参与共享。"
                       TextWrapping="Wrap" />
            <TextBlock Classes="captionSecondary" Text="未发现共享会话。" IsVisible="{Binding !HasHostStatuses}" />
            <ScrollViewer MaxHeight="120" IsVisible="{Binding HasHostStatuses}">
              <ItemsControl ItemsSource="{Binding HostStatuses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:HostStatusSession">
                    <StackPanel Spacing="1" Margin="0,2">
                      <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Classes="captionSecondary" Text="{Binding PathLine}" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4,0,12" />

          <StackPanel Spacing="8">
            <TextBlock Classes="sectionHeader" Text="新建实例" />
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,8,6" />
              <TextBox x:Name="NewName" Grid.Row="0" Grid.Column="1" Margin="0,0,12,6" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="机型" VerticalAlignment="Center" Margin="0,0,8,6" />
              <ComboBox x:Name="NewModel" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                        ItemsSource="{Binding Presets}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FirmwarePreset">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="固件" VerticalAlignment="Center" Margin="0,0,8,6" />
              <ComboBox x:Name="NewProfile" Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                        HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="SN" VerticalAlignment="Center" Margin="0,0,8,6" />
              <TextBox x:Name="NewSerial" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="蓝牙地址" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="NewAddress" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" />
              <CheckBox x:Name="NewSkipOobe" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                        Content="跳过首次设置" IsChecked="True" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="创建实例" Click="CreateInstance_Click" Classes="accent" />
              <Button Content="清理过期会话" Command="{Binding CleanupSessionsCommand}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="sectionHeader" Text="固件库" VerticalAlignment="Center" />
            <Button Content="导入 OTA" Command="{Binding ImportFirmwareCommand}" Click="ImportFirmware_Click"
                    Classes="accent" />
            <Button Content="删除所选" Command="{Binding DeleteFirmwareCommand}" />
            <Button Content="删除全部镜像" Click="DeleteAll_Click" />
          </StackPanel>
          <ListBox ItemsSource="{Binding FirmwareItems}" SelectedItem="{Binding SelectedFirmware}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Reason}" IsVisible="{Binding !Ready}"
                             Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <ui:InfoBar Grid.Row="2" Margin="24,0,24,20" IsOpen="True" IsClosable="False"
                Severity="Informational" Message="{Binding StatusText}" />
  </Grid>
</Window>
